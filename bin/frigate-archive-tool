#!/usr/bin/env python3
"""
frigate-archive-tool — turn the archive of Frigate recordings into something reviewable.

Called by frigate-archive (the sync, every few minutes) after each successful rsync:
  consolidate    join each finished hour of 10s segments into one mp4 per camera, plus a
                 sidecar JSON (wall-clock map, motion, Frigate review items). Joins from
                 LOCAL segments where present (only recent hours are staged raw on the
                 archive), so the archive filesystem sees each byte about once.
  index          rebuild index.json for the review page; prune past retention
  filter         stdin: segment paths -> stdout: those whose hour isn't consolidated yet
Nightly (frigate-timelapse.timer):
  timelapse [YYYY-MM-DD] [--cams a,b]     default: yesterday (local), TIMELAPSE_CAMERAS
Manual:
  clip <camera> <start> <duration> [out]   e.g.  clip garden "2026-10-21 14:00" 45m
                                           (also installed as `frigate-clip`)
  export --cams a,b --start T (--end T | --duration D) [--x265|--gpu [--crf N] [--height H]]
                 one file per camera into exports/<id>/ (also what the page's Export runs)
  serve          export API for the review page (frigate-archive-export.service)
  harvest        save Frigate metadata for not-yet-joined hours (run before cutting
                 Frigate's local retention)
  check          validate config and dependencies

Configuration: /etc/frigate-archive/frigate-archive.conf (or $FRIGATE_ARCHIVE_CONF).
Environment variables with the same names override the file.

Archive layout (UTC dates/hours, same as Frigate's recordings dir):
  recordings/<date>/<HH>/<cam>/MM.SS.mp4   raw staging for recent hours (rsync target)
  hourly/<cam>/<date>/<HH>.json            sidecar; lists the hour's mp4 part(s)
  hourly/<cam>/<date>/<HH>[.pN].mp4        a new part starts if codec/resolution changes
  thumbs/<cam>/<review-id>.webp
  timelapse/<cam>/<local-date>.mp4|.json
  clips/                                   output of `clip`
  exports/<id>/job.json, *.mp4             exports (page or `export`), kept EXPORT_KEEP_DAYS
  index.json
"""
import argparse
import bisect
import calendar
import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

VERSION = "0.1.0"                # keep in step with the footer in www/index.html

# --- configuration -----------------------------------------------------------

DEFAULTS = {
    "ARCHIVE": "/mnt/frigate-archive",
    "FRIGATE_MEDIA": "/opt/frigate/data",   # host path mounted at /media/frigate in the container
    "FRIGATE_API": "docker:frigate",        # docker:<container> or http://host:5000 (unauthenticated port)
    "KEEP_DAYS": "14",
    "CONSOLIDATE_AFTER_MIN": "15",
    "CONSOLIDATE_BUDGET_MIN": "8",
    "TIMELAPSE_CAMERAS": "",
    "TIMELAPSE_INTERVAL": "8",
    "TIMELAPSE_FPS": "30",
    "TZ": "",
    "TMP_DIR": "/var/tmp/frigate-archive",
    # used by the bash sync (frigate-archive); listed here so `check` can report on them
    "BWLIMIT": "30M",
    "SETTLE_MIN": "2",
    "RAW_WINDOW_MIN": "120",
    "MQTT_HOST": "",
    "MQTT_PORT": "1883",
    "MQTT_USER": "",
    "MQTT_PASSWORD": "",
    "MQTT_PASSWORD_FILE": "",
    "MQTT_PASSWORD_KEY": "",
    "MQTT_TOPIC": "frigate/archive/status",
    "STATUS_FILE": "/var/lib/frigate-archive/status.json",
    "LOCK_FILE": "/run/frigate-archive.lock",
    # export (the review page's Export panel talks to `serve`)
    "EXPORT_LISTEN": "127.0.0.1:8597",
    "EXPORT_KEEP_DAYS": "7",
    "EXPORT_MAX_HOURS": "24",
    "EXPORT_THREADS": "",
    "EXPORT_VAAPI_DEVICE": "/dev/dri/renderD128",
}
CONF_PATH = os.environ.get("FRIGATE_ARCHIVE_CONF", "/etc/frigate-archive/frigate-archive.conf")


def load_conf(path):
    """Shell-style KEY=value file (the bash sync sources the same file). Env vars override."""
    conf = dict(DEFAULTS)
    if os.path.exists(path):
        for line in open(path):
            m = re.match(r"\s*([A-Z_][A-Z0-9_]*)=(.*)$", line)
            if not m:
                continue
            v = m[2].strip()
            q = re.match(r"""^(["'])(.*?)\1""", v)
            if q:
                v = q[2]                                # quoted: take the inside, ignore the rest
            else:
                v = re.sub(r"\s+#.*$", "", v).strip()  # trailing comment on an unquoted value
            conf[m[1]] = v
    for k in conf:
        if k in os.environ:
            conf[k] = os.environ[k]
    return conf


CONF = load_conf(CONF_PATH)
if CONF["TZ"]:
    os.environ["TZ"] = CONF["TZ"]
    time.tzset()

ARCHIVE = Path(CONF["ARCHIVE"])
MEDIA = Path(CONF["FRIGATE_MEDIA"])
SRC = MEDIA / "recordings"
CLIPS_SRC = MEDIA / "clips"
CONTAINER_MEDIA = "/media/frigate"
KEEP_DAYS = float(CONF["KEEP_DAYS"])
CONSOLIDATE_AFTER = float(CONF["CONSOLIDATE_AFTER_MIN"]) * 60
CONSOLIDATE_BUDGET = float(CONF["CONSOLIDATE_BUDGET_MIN"]) * 60
MAX_SEG = 60                    # Frigate writes ~10s segments; anything claiming longer is corrupt
TL_CAMS = [c for c in re.split(r"[\s,]+", CONF["TIMELAPSE_CAMERAS"]) if c]
TL_INTERVAL = int(CONF["TIMELAPSE_INTERVAL"])
TL_FPS = int(CONF["TIMELAPSE_FPS"])

RAW = ARCHIVE / "recordings"
HOURLY = ARCHIVE / "hourly"
THUMBS = ARCHIVE / "thumbs"
TIMELAPSE = ARCHIVE / "timelapse"
EXPORTS = ARCHIVE / "exports"
META = ARCHIVE / ".meta"        # harvested Frigate metadata for hours not yet joined (see harvest)
MARKER = ARCHIVE / ".frigate-archive"
TMP = None                      # per-process scratch dir, created in main()


def log(*a):
    print(*a, file=sys.stderr, flush=True)


# --- helpers -----------------------------------------------------------------

def api(path):
    """GET Frigate's internal API. Returns parsed JSON or None."""
    base = CONF["FRIGATE_API"]
    try:
        if base.startswith("docker:"):
            # port 5000 is usually container-only; reach it from inside
            out = subprocess.run(
                ["docker", "exec", base[7:], "curl", "-sf", f"http://127.0.0.1:5000/api/{path}"],
                capture_output=True, timeout=60,
            ).stdout
        else:
            with urllib.request.urlopen(f"{base.rstrip('/')}/api/{path}", timeout=60) as r:
                out = r.read()
        return json.loads(out) if out else None
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return None


def ffprobe(path):
    """-> (signature, duration) or (None, None) if unreadable."""
    r = subprocess.run(
        ["ffprobe", "-v", "error", "-show_entries",
         "stream=codec_type,codec_name,width,height,duration:format=duration", "-of", "json", str(path)],
        capture_output=True, text=True,
    )
    try:
        d = json.loads(r.stdout)
        v = next(s for s in d["streams"] if s["codec_type"] == "video")
        a = next((s["codec_name"] for s in d["streams"] if s["codec_type"] == "audio"), None)
        # prefer the video stream's duration: glitchy segments (camera reboots) can carry a
        # stray audio timestamp that inflates the container duration to ~a day
        dur = float(v.get("duration") or d["format"]["duration"])
        return (v["codec_name"], v["width"], v["height"], a), dur
    except (KeyError, StopIteration, ValueError, json.JSONDecodeError):
        return None, None


def ffmpeg(*args):
    r = subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-y", *args],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"ffmpeg failed: {r.stderr.strip()[-500:]}")


def hour_epoch(date, hh):
    return calendar.timegm(time.strptime(f"{date} {hh}", "%Y-%m-%d %H"))


def utc_parts(epoch):
    t = time.gmtime(epoch)
    return time.strftime("%Y-%m-%d", t), time.strftime("%H", t)


def write_json(path, obj):
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(json.dumps(obj, separators=(",", ":")))
    os.replace(tmp, path)


def publish_file(local, dest):
    """Copy a finished local file into the archive atomically."""
    tmp = dest.with_name(f".{dest.name}.tmp")
    shutil.copyfile(local, tmp)
    os.replace(tmp, dest)


def sidecar(cam, date, hh):
    return HOURLY / cam / date / f"{hh}.json"


def load_hour(cam, epoch):
    date, hh = utc_parts(epoch)
    p = sidecar(cam, date, hh)
    return json.loads(p.read_text()) if p.exists() else None


def file_to_wall(segs, t):
    """Map a time offset inside a joined part to wall-clock epoch."""
    offs = [s[1] for s in segs]
    i = max(0, bisect.bisect_right(offs, t) - 1)
    start, off, dur = segs[i][:3]
    return start + min(t - off, dur)


# --- consolidate -------------------------------------------------------------

def hours_to_consolidate():
    """(date, hh, cam) for finished hours that exist locally or staged and have no sidecar yet."""
    found = set()
    for root in (SRC, RAW):
        if not root.is_dir():
            continue
        for d in root.glob("[0-9]*-*-*/[0-2][0-9]/*"):
            if d.is_dir():
                found.add((d.parent.parent.name, d.parent.name, d.name))
    now = time.time()
    for date, hh, cam in sorted(found, reverse=True):     # newest first
        if now < hour_epoch(date, hh) + 3600 + CONSOLIDATE_AFTER:
            continue
        if hour_epoch(date, hh) < now - KEEP_DAYS * 86400:
            continue                                   # would be pruned straight away
        if sidecar(cam, date, hh).exists():
            # joined already; just drop any leftover staging
            shutil.rmtree(RAW / date / hh / cam, ignore_errors=True)
            continue
        if (HOURLY / cam / date / f"{hh}.failed").exists():
            continue
        yield date, hh, cam


def join(g, vcodec, out):
    lst = TMP / "concat.txt"
    # outpoint/duration pin each segment to its known length, so stray far-future
    # timestamps in a glitchy segment are dropped instead of stretching the timeline
    lst.write_text("ffconcat version 1.0\n" + "".join(
        f"file '{s['path']}'\noutpoint {s['dur']:.3f}\nduration {s['dur']:.3f}\n" for s in g))
    ffmpeg("-f", "concat", "-safe", "0", "-i", str(lst), "-map", "0:v", "-map", "0:a?", "-c", "copy",
           *(["-tag:v", "hvc1"] if vcodec == "hevc" else []),   # hvc1 tag so browsers play HEVC mp4
           "-movflags", "+faststart", str(out))


def consolidate_hour(date, hh, cam):
    start = hour_epoch(date, hh)
    files = {}
    for root in (RAW, SRC):                            # local copy wins over staged
        for f in (root / date / hh / cam).glob("*.mp4"):
            if re.fullmatch(r"\d\d\.\d\d\.mp4", f.name):
                files[f.name] = f
    if not files:
        return
    meta_file = META / cam / date / f"{hh}.json"
    meta = json.loads(meta_file.read_text()) if meta_file.exists() else {}
    recs = api(f"{cam}/recordings?after={start}&before={start + 3600}") or meta.get("recordings", [])
    recs = {int(r["start_time"]): r for r in recs}

    segs = []
    for name in sorted(files):
        mm, ss = name[:5].split(".")
        t = start + int(mm) * 60 + int(ss)
        r = recs.get(t, {})
        segs.append({"path": files[name], "start": r.get("start_time", t), "dur": r.get("duration"),
                     "motion": r.get("motion"), "objects": r.get("objects")})

    # codec/resolution: probe the ends; only probe everything if they differ (e.g. camera reconfigured)
    first, _ = ffprobe(segs[0]["path"])
    last, _ = ffprobe(segs[-1]["path"])
    uniform = first is not None and first == last
    for s in segs:
        if uniform and s["dur"]:
            s["sig"] = first
        else:
            s["sig"], d = ffprobe(s["path"])
            s["dur"] = s["dur"] or d
    bad = [s for s in segs if not s["sig"] or not s["dur"] or not 0 < s["dur"] < MAX_SEG]
    for s in bad:
        log(f"  skipping unreadable segment {s['path']}")
    segs = [s for s in segs if s not in bad]

    groups = []
    for s in segs:
        if not groups or groups[-1][-1]["sig"] != s["sig"]:
            groups.append([])
        groups[-1].append(s)
    # a camera dropping out can leave a lone fragment of a few frames; nothing worth a part
    groups = [g for g in groups if sum(s["dur"] for s in g) >= 1]

    outdir = HOURLY / cam / date
    outdir.mkdir(parents=True, exist_ok=True)
    parts = []
    for k, g in enumerate(groups):
        name = f"{hh}.mp4" if k == 0 else f"{hh}.p{k + 1}.mp4"
        out = TMP / name
        vcodec = g[0]["sig"][0]
        try:
            join(g, vcodec, out)
        except RuntimeError as e:
            # usually one corrupt segment crashing ffmpeg: test each alone, drop failures, retry once
            log(f"  {cam} {date} {hh}Z {name}: {e} — checking segments individually")
            ok = [s for s in g if subprocess.run(
                ["ffmpeg", "-v", "error", "-nostdin", "-i", str(s["path"]), "-map", "0", "-c", "copy", "-f", "null", "-"],
                capture_output=True).returncode == 0]
            log(f"  dropping {len(g) - len(ok)} bad segment(s)")
            if not ok or len(ok) == len(g):
                raise
            g[:] = ok
            join(g, vcodec, out)
        expect = sum(s["dur"] for s in g)
        _, got = ffprobe(out)
        if not got or abs(got - expect) > max(5, expect * 0.03):
            raise RuntimeError(f"{name}: joined duration {got} vs expected {expect:.1f}")
        publish_file(out, outdir / name)
        out.unlink()
        off, rows = 0.0, []
        for s in g:
            rows.append([round(s["start"], 2), round(off, 2), round(s["dur"], 2), s["motion"], s["objects"]])
            off += s["dur"]
        parts.append({"file": name, "codec": vcodec, "w": g[0]["sig"][1], "h": g[0]["sig"][2], "segs": rows})

    review = []
    for r in api(f"review?cameras={cam}&after={start}&before={start + 3600}&limit=1000") or meta.get("review", []):
        if not start <= r["start_time"] < start + 3600:   # each item belongs to the hour it started in
            continue
        d = r.get("data") or {}
        copy_thumb(cam, r)
        has_thumb = (THUMBS / cam / f"{r['id']}.webp").exists()
        review.append({"id": r["id"], "start": r["start_time"], "end": r["end_time"], "severity": r["severity"],
                       "objects": list(dict.fromkeys(o.removesuffix("-verified") for o in d.get("objects", []))),
                       "sub_labels": d.get("sub_labels", []), "zones": d.get("zones", []), "thumb": has_thumb})

    write_json(outdir / f"{hh}.json", {"camera": cam, "date": date, "hour": hh, "start": start,
                                       "parts": parts, "review": review})
    shutil.rmtree(RAW / date / hh / cam, ignore_errors=True)
    meta_file.unlink(missing_ok=True)


def copy_thumb(cam, r):
    tp = r.get("thumb_path") or ""
    if not tp.startswith(f"{CONTAINER_MEDIA}/clips/"):
        return
    src = CLIPS_SRC / Path(tp).relative_to(f"{CONTAINER_MEDIA}/clips")
    dest = THUMBS / cam / f"{r['id']}.webp"
    if src.exists() and not dest.exists():
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, dest)


def cmd_harvest(_args):
    """Save Frigate's per-hour metadata (segment motion/durations, review items + thumbs) for every
    hour not yet joined, so it survives Frigate deleting local footage before consolidation gets there.
    Run before cutting local retention; consolidate falls back to it automatically."""
    cfg = api("config")
    if not cfg:
        sys.exit("can't reach Frigate's API (FRIGATE_API)")
    now = int(time.time())
    for cam in sorted(cfg["cameras"]):
        n = 0
        for day0 in range(int(now - KEEP_DAYS * 86400) // 86400 * 86400, now, 86400):
            recs = api(f"{cam}/recordings?after={day0}&before={day0 + 86400}") or []
            revs = api(f"review?cameras={cam}&after={day0}&before={day0 + 86400}&limit=10000") or []
            for ep in range(day0, day0 + 86400, 3600):
                date, hh = utc_parts(ep)
                if sidecar(cam, date, hh).exists():
                    continue
                hr = [{k: r[k] for k in ("start_time", "duration", "motion", "objects")}
                      for r in recs if ep <= r["start_time"] < ep + 3600]
                hv = [r for r in revs if ep <= r["start_time"] < ep + 3600]
                if not hr and not hv:
                    continue
                for r in hv:
                    copy_thumb(cam, r)
                (META / cam / date).mkdir(parents=True, exist_ok=True)
                write_json(META / cam / date / f"{hh}.json", {"recordings": hr, "review": hv})
                n += 1
        log(f"harvest {cam}: {n} hours")


def cmd_consolidate(_args):
    t0, done, failed = time.time(), 0, 0
    for date, hh, cam in hours_to_consolidate():
        if time.time() - t0 > CONSOLIDATE_BUDGET:
            log("consolidate: time budget used, continuing next run")
            break
        try:
            consolidate_hour(date, hh, cam)
            done += 1
            log(f"consolidated {cam} {date} {hh}Z")
        except Exception as e:                          # keep going; mark so we don't retry forever
            failed += 1
            log(f"FAILED {cam} {date} {hh}Z: {e}")
            (HOURLY / cam / date).mkdir(parents=True, exist_ok=True)
            (HOURLY / cam / date / f"{hh}.failed").write_text(str(e))
    for d in sorted(RAW.glob("*/*/*"), reverse=True) + sorted(RAW.glob("*/*"), reverse=True) + sorted(RAW.glob("*")):
        if d.is_dir() and not any(d.iterdir()):
            d.rmdir()
    print(json.dumps({"consolidated": done, "failed": failed}))
    return 1 if failed else 0


def cmd_filter(_args):
    seen = {}
    for line in sys.stdin:
        p = line.strip()
        m = re.match(r"(\d{4}-\d\d-\d\d)/(\d\d)/([^/]+)/", p)
        if not m:
            continue
        if m.groups() not in seen:
            seen[m.groups()] = not sidecar(m[3], m[1], m[2]).exists()
        if seen[m.groups()]:
            print(p)


# --- index / prune -----------------------------------------------------------

def write_day(daydir):
    """hourly/<cam>/<date>/day.json: all of that UTC day's sidecars in one file, so the page
    fetches one file per camera per day instead of 24."""
    hours = {}
    for j in sorted(daydir.glob("[0-2][0-9].json")):
        try:
            hours[j.stem] = json.loads(j.read_text())
        except (OSError, json.JSONDecodeError):
            pass
    out = daydir / "day.json"
    if hours:
        write_json(out, {"camera": daydir.parent.name, "date": daydir.name, "hours": hours})
    else:
        out.unlink(missing_ok=True)


def pending_ranges():
    """Raw segments already staged on the archive but not joined yet, per camera, as merged
    [start, end] epoch ranges, so the page can show that the footage is there."""
    starts = {}
    for d in RAW.glob("[0-9]*-*-*/[0-2][0-9]/*") if RAW.is_dir() else []:
        if not d.is_dir():
            continue
        ep = hour_epoch(d.parent.parent.name, d.parent.name)
        for f in d.iterdir():
            if re.fullmatch(r"\d\d\.\d\d\.mp4", f.name):
                starts.setdefault(d.name, []).append(ep + int(f.name[:2]) * 60 + int(f.name[3:5]))
    out = {}
    for cam, ss in starts.items():
        ranges = []
        for s in sorted(ss):
            if ranges and s <= ranges[-1][1] + 5:   # segments are ~10s; allow a little slack
                ranges[-1][1] = max(ranges[-1][1], s + 10)
            else:
                ranges.append([s, s + 10])
        out[cam] = ranges
    return out


def camera_groups(previous):
    """Frigate's camera groups ({name: [cams]}, in Frigate's order), for the page's camera picker.
    Keeps the last known groups if Frigate can't be reached."""
    cfg = api("config")
    if not cfg:
        return previous
    groups = sorted((cfg.get("camera_groups") or {}).items(), key=lambda kv: (kv[1].get("order", 0), kv[0]))
    return {name: [c for c in g.get("cameras", []) if c in cfg.get("cameras", {})] for name, g in groups}


def cmd_index(_args):
    cutoff = time.time() - KEEP_DAYS * 86400
    cams = {}
    for camdir in sorted(HOURLY.glob("*")) if HOURLY.is_dir() else []:
        hours = []
        for daydir in sorted(camdir.glob("*")):
            if not daydir.is_dir():
                continue
            pruned = False
            for j in sorted(daydir.glob("[0-2][0-9].json")):
                ep = hour_epoch(daydir.name, j.stem)
                if ep + 3600 < cutoff:
                    for f in daydir.glob(f"{j.stem}.*"):
                        f.unlink()
                    pruned = True
                    continue
                hours.append(ep)
            day = daydir / "day.json"
            newest = max((j.stat().st_mtime for j in daydir.glob("[0-2][0-9].json")), default=0)
            if pruned or (newest and (not day.exists() or day.stat().st_mtime < newest)):
                write_day(daydir)
            if not any(daydir.iterdir()):
                daydir.rmdir()
        cams.setdefault(camdir.name, {})["hours"] = hours
    for cam, ranges in pending_ranges().items():
        cams.setdefault(cam, {})["pending"] = ranges
    today = dt.date.today()
    for camdir in sorted(TIMELAPSE.glob("*")) if TIMELAPSE.is_dir() else []:
        days = []
        for j in sorted(camdir.glob("*.json")):
            if (today - dt.date.fromisoformat(j.stem)).days > KEEP_DAYS:
                j.unlink()
                j.with_suffix(".mp4").unlink(missing_ok=True)
                continue
            if j.with_suffix(".mp4").exists():
                days.append(j.stem)
        cams.setdefault(camdir.name, {})["timelapse"] = days
    for t in THUMBS.glob("*/*.webp") if THUMBS.is_dir() else []:
        try:
            if float(t.stem.split("-")[0]) < cutoff:
                t.unlink()
        except ValueError:
            pass
    for c in cams.values():
        c.setdefault("hours", [])
        c.setdefault("timelapse", [])
        c.setdefault("pending", [])
    prune_exports()
    try:
        previous = json.loads((ARCHIVE / "index.json").read_text()).get("groups", {})
    except (OSError, json.JSONDecodeError):
        previous = {}
    write_json(ARCHIVE / "index.json", {"generated": int(time.time()), "keep_days": KEEP_DAYS,
                                        "cameras": cams, "groups": camera_groups(previous)})


# --- timelapse ---------------------------------------------------------------

def local_day_bounds(day):
    """Local midnight to midnight as epochs (naive -> astimezone resolves DST, so 23/25h days work)."""
    s = dt.datetime.combine(day, dt.time()).astimezone()
    e = dt.datetime.combine(day + dt.timedelta(days=1), dt.time()).astimezone()
    return int(s.timestamp()), int(e.timestamp())


def cmd_timelapse(args):
    day = dt.date.fromisoformat(args.date) if args.date else dt.date.today() - dt.timedelta(days=1)
    cams = args.cams.split(",") if args.cams else TL_CAMS
    if not cams:
        log("no cameras: set TIMELAPSE_CAMERAS or pass --cams")
        return 0
    s, e = local_day_bounds(day)
    rc = 0
    for cam in cams:
        chunks, frames = [], []
        for ep in range(s - s % 3600, e, 3600):
            h = load_hour(cam, ep)
            if not h:
                continue
            date, _ = utc_parts(ep)
            for part in h["parts"]:
                chunk = TMP / f"tl-{cam}-{len(chunks):03d}.mp4"
                ff = ["-i", str(HOURLY / cam / date / part["file"]), "-an",
                      "-vf", f"fps=1/{TL_INTERVAL},scale=1280:720:force_original_aspect_ratio=decrease,"
                             f"pad=1280:720:(ow-iw)/2:(oh-ih)/2,setsar=1,setpts=N/{TL_FPS}/TB",
                      "-fps_mode", "cfr", "-r", str(TL_FPS),
                      "-c:v", "libx264", "-preset", "veryfast", "-crf", "27", "-pix_fmt", "yuv420p", str(chunk)]
                try:
                    ffmpeg("-skip_frame", "nokey", *ff)    # keyframes only: cheap even for 4K HEVC
                except RuntimeError as ex:
                    # some ffmpeg builds' HEVC decoders crash in keyframe-only mode on some
                    # camera streams; a full decode is slower but gets through
                    log(f"  {cam} {part['file']}: {ex} — retrying with full decode")
                    try:
                        ffmpeg(*ff)
                    except RuntimeError as ex2:
                        log(f"  {cam} {part['file']}: {ex2}")
                        continue
                n = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v", "-count_packets",
                                    "-show_entries", "stream=nb_read_packets", "-of", "csv=p=0", str(chunk)],
                                   capture_output=True, text=True).stdout.strip()
                n = int(n) if n.isdigit() else 0
                if not n:
                    continue
                frames += [int(file_to_wall(part["segs"], i * TL_INTERVAL)) for i in range(n)]
                chunks.append(chunk)
        if not chunks:
            log(f"timelapse {cam} {day}: no footage")
            continue
        lst = TMP / "tl-concat.txt"
        lst.write_text("ffconcat version 1.0\n" + "".join(f"file '{c}'\n" for c in chunks))
        out = TMP / f"tl-{cam}.mp4"
        try:
            ffmpeg("-f", "concat", "-safe", "0", "-i", str(lst), "-c", "copy", "-movflags", "+faststart", str(out))
            (TIMELAPSE / cam).mkdir(parents=True, exist_ok=True)
            publish_file(out, TIMELAPSE / cam / f"{day}.mp4")
            write_json(TIMELAPSE / cam / f"{day}.json", {"camera": cam, "date": str(day), "fps": TL_FPS,
                                                         "interval": TL_INTERVAL, "frames": frames})
            log(f"timelapse {cam} {day}: {len(frames)} frames ({len(frames) / TL_FPS / 60:.1f} min)")
        except RuntimeError as ex:
            log(f"timelapse {cam} {day} FAILED: {ex}")
            rc = 1
        finally:
            for c in chunks:
                c.unlink(missing_ok=True)
            out.unlink(missing_ok=True)
    cmd_index(None)
    return rc


# --- clip --------------------------------------------------------------------

def parse_when(s):
    if re.fullmatch(r"@\d+", s):                       # @epoch, unambiguous (DST changeovers)
        return int(s[1:])
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%H:%M:%S", "%H:%M"):
        try:
            t = dt.datetime.strptime(s, fmt)
        except ValueError:
            continue
        if t.year == 1900:
            t = dt.datetime.combine(dt.date.today(), t.time())
        return int(t.astimezone().timestamp())
    sys.exit(f"can't parse time '{s}' (use 'YYYY-MM-DD HH:MM' or 'HH:MM' for today, local time)")


def parse_dur(s):
    m = re.fullmatch(r"(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", s)
    if not m or not any(m.groups()):
        sys.exit(f"can't parse duration '{s}' (e.g. 45m, 1h30m, 90s)")
    h, mi, se = (int(x or 0) for x in m.groups())
    return h * 3600 + mi * 60 + se


def cmd_clip(args):
    s = parse_when(args.start)
    e = s + parse_dur(args.duration)
    pieces = []                                         # (path, file_from, file_to, codec)
    for ep in range(s - s % 3600, e, 3600):
        h = load_hour(args.camera, ep)
        if not h:
            continue
        date, _ = utc_parts(ep)
        for part in h["parts"]:
            hits = [(max(st, s) - st + off, min(st + du, e) - st + off)
                    for st, off, du, *_ in part["segs"] if st < e and st + du > s]
            if hits:
                pieces.append((HOURLY / args.camera / date / part["file"], hits[0][0], hits[-1][1], part["codec"]))
    if not pieces:
        sys.exit("no archived footage in that range (the most recent hour is only in Frigate — use its Export)")
    stamp = dt.datetime.fromtimestamp(s).strftime("%Y%m%d_%H%M%S")
    out = Path(args.out) if args.out else ARCHIVE / "clips" / f"{args.camera}_{stamp}_{args.duration}.mp4"
    out.parent.mkdir(parents=True, exist_ok=True)
    groups = []
    for p in pieces:
        if not groups or groups[-1][-1][3] != p[3]:
            groups.append([])
        groups[-1].append(p)
    for k, g in enumerate(groups):
        tmps = []
        for i, (path, a, b, _) in enumerate(g):
            t = TMP / f"clip-{i}.mp4"
            ffmpeg("-ss", f"{a:.2f}", "-to", f"{b:.2f}", "-i", str(path), "-map", "0", "-c", "copy", str(t))
            tmps.append(t)
        lst = TMP / "clip-concat.txt"
        lst.write_text("ffconcat version 1.0\n" + "".join(f"file '{t}'\n" for t in tmps))
        dest = out if k == 0 else out.with_name(f"{out.stem}.p{k + 1}{out.suffix}")
        local = TMP / "clip-out.mp4"
        ffmpeg("-f", "concat", "-safe", "0", "-i", str(lst), "-c", "copy", "-movflags", "+faststart", str(local))
        publish_file(local, dest)
        for t in tmps + [local]:
            t.unlink(missing_ok=True)
        print(dest)


# --- export ------------------------------------------------------------------
#
# One video file per camera for a time range, optionally re-encoded to H.265 (x265).
# Jobs live in <ARCHIVE>/exports/<id>/ (job.json + the finished files), so the review page can
# list and download them; `serve` runs queued jobs one at a time, `export` runs one directly.

JOB_ID_RE = re.compile(r"\d{8}-\d{6}-[0-9a-f]{4}")
CAM_RE = re.compile(r"[A-Za-z0-9_-]{1,64}")
CRFS = range(18, 41)
HEIGHTS = (480, 720, 1080, 1440)


_vaapi = None


def vaapi_ok():
    """Can this host encode HEVC with VAAPI? (needs the GPU's VA driver on the host, e.g. intel-media-va-driver)"""
    global _vaapi
    if _vaapi is None:
        dev = CONF["EXPORT_VAAPI_DEVICE"]
        _vaapi = bool(dev) and os.path.exists(dev) and subprocess.run(
            ["ffmpeg", "-v", "error", "-nostdin", "-vaapi_device", dev, "-f", "lavfi", "-i", "testsrc=size=320x240:d=0.2",
             "-vf", "format=nv12,hwupload", "-c:v", "hevc_vaapi", "-f", "null", "-"],
            capture_output=True, timeout=30).returncode == 0
    return _vaapi


def encoders():
    return ["copy", "x265"] + (["vaapi"] if vaapi_ok() else [])


def known_cameras():
    cams = {d.name for d in HOURLY.glob("*") if d.is_dir()} if HOURLY.is_dir() else set()
    for root in (SRC, RAW):
        if root.is_dir():
            cams |= {d.name for d in root.glob("[0-9]*-*-*/[0-2][0-9]/*") if d.is_dir()}
    return cams


def job_path(jid):
    return EXPORTS / jid / "job.json"


def load_job(jid):
    try:
        return json.loads(job_path(jid).read_text())
    except (OSError, json.JSONDecodeError):
        return None


def save_job(job):
    (EXPORTS / job["id"]).mkdir(parents=True, exist_ok=True)
    write_json(job_path(job["id"]), job)


def new_job(cams, s, e, encode="copy", crf=30, height=None, state="queued"):
    jid = f"{time.strftime('%Y%m%d-%H%M%S')}-{os.urandom(2).hex()}"
    job = {"id": jid, "created": int(time.time()), "cameras": cams, "start": s, "end": e,
           "encode": encode, "crf": crf, "height": height, "state": state, "progress": 0,
           "message": "", "files": []}
    save_job(job)
    return job


def dur_label(sec):
    h, m, s = sec // 3600, sec % 3600 // 60, sec % 60
    return "".join(f"{v}{u}" for v, u in ((h, "h"), (m, "m"), (s, "s")) if v) or "0s"


def export_pieces(cam, s, e):
    """Footage of cam overlapping [s, e) in time order: [(path, file_dur, a, b, sig)], where a..b is
    the wanted span as offsets into the file. Joined hours come from hourly/, hours not joined yet
    from raw segments (local first, then staged), so an export can reach up to a few minutes ago."""
    out = []
    for ep in range(s - s % 3600, e, 3600):
        date, hh = utc_parts(ep)
        h = load_hour(cam, ep)
        if h:
            for part in h["parts"]:
                hits = [(max(st, s) - st + off, min(st + du, e) - st + off)
                        for st, off, du, *_ in part["segs"] if st < e and st + du > s]
                if not hits:
                    continue
                path = HOURLY / cam / date / part["file"]
                sig, fdur = ffprobe(path)
                if sig and fdur:
                    out.append((path, fdur, hits[0][0], min(hits[-1][1], fdur), sig))
            continue
        files = {}
        for root in (RAW, SRC):                        # local copy wins over staged
            for f in (root / date / hh / cam).glob("*.mp4"):
                if re.fullmatch(r"\d\d\.\d\d\.mp4", f.name):
                    files[f.name] = f
        for name in sorted(files):
            st = ep + int(name[:2]) * 60 + int(name[3:5])
            if st >= e or st + MAX_SEG <= s:
                continue
            sig, du = ffprobe(files[name])
            if not sig or not du or not 0 < du < MAX_SEG or st + du <= s:
                continue
            out.append((files[name], du, max(0.0, s - st), min(du, e - st), sig))
    return out


def ffmpeg_progress(args, on_time):
    """Run ffmpeg, calling on_time(seconds_of_output) as it goes."""
    err = TMP / "ffmpeg.err"
    with open(err, "w") as ef:
        p = subprocess.Popen(["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-y",
                              "-progress", "pipe:1", "-nostats", *args],
                             stdout=subprocess.PIPE, stderr=ef, text=True)
        for line in p.stdout:
            if line.startswith("out_time_us="):
                v = line.split("=", 1)[1].strip()
                if v.lstrip("-").isdigit():
                    on_time(max(0, int(v)) / 1e6)
        rc = p.wait()
    if rc != 0:
        raise RuntimeError(f"ffmpeg failed ({rc}): {err.read_text().strip()[-500:]}")


def run_export(job):
    s, e, enc = job["start"], job["end"], job["encode"]
    stamp = dt.datetime.fromtimestamp(s).strftime("%Y%m%d-%H%M%S")
    outdir = EXPORTS / job["id"]

    plan = {}                                          # cam -> list of groups (consecutive same-sig pieces)
    for cam in job["cameras"]:
        groups = []
        for p in export_pieces(cam, s, e):
            if not groups or groups[-1][-1][4] != p[4]:
                groups.append([])
            groups[-1].append(p)
        plan[cam] = [g for g in groups if group_len(g) >= 1]
    total = sum(group_len(g) for gs in plan.values() for g in gs)
    if not total:
        raise RuntimeError("no archived footage for those cameras in that range")

    done, last_save = 0.0, 0.0

    def progress(t):
        nonlocal last_save
        if time.time() - last_save > 2:
            job["progress"] = round(min(0.999, (done + t) / total), 4)
            save_job(job)
            last_save = time.time()

    notes = []
    for cam, groups in plan.items():
        if not groups:
            notes.append(f"{cam}: no footage")
            continue
        job["message"] = f"exporting {cam}"
        save_job(job)
        base = f"{cam}_{stamp}_{dur_label(e - s)}"
        if enc == "copy":
            # stream copy can't splice different codecs/resolutions: one file per run of the same kind
            for k, g in enumerate(groups):
                name = f"{base}.mp4" if k == 0 else f"{base}.p{k + 1}.mp4"
                tmp = outdir / f".{name}.part"
                ffmpeg_progress([*concat_input(g), "-map", "0:v", "-map", "0:a?", "-c", "copy",
                                 *(["-tag:v", "hvc1"] if g[0][4][0] == "hevc" else []),
                                 "-movflags", "+faststart", "-f", "mp4", str(tmp)], progress)
                os.replace(tmp, outdir / name)
                done += group_len(g)
                add_file(job, cam, outdir / name, group_len(g))
            if len(groups) > 1:
                notes.append(f"{cam}: {len(groups)} parts (camera changed codec/resolution; "
                             "pick H.265 to get one file)")
        else:
            # re-encode every run to the same size/codec/audio layout, then splice them losslessly
            tallest = max(groups, key=lambda g: g[0][4][2])[0][4]
            h = min(job["height"] or tallest[2], tallest[2])
            h -= h % 2
            w = round(tallest[1] * h / tallest[2] / 2) * 2
            audio = any(g[0][4][3] for g in groups)
            pools = CONF["EXPORT_THREADS"]
            gpu, dev = enc == "vaapi", CONF["EXPORT_VAAPI_DEVICE"]
            if gpu:
                # ICQ quality is on roughly the same scale as x265's CRF (similar sizes at the same number)
                venc = ["-c:v", "hevc_vaapi", "-rc_mode", "ICQ", "-global_quality", str(job["crf"])]
            else:
                venc = ["-c:v", "libx265", "-preset", "medium", "-crf", str(job["crf"]),
                        "-x265-params", "log-level=error" + (f":pools={pools}" if pools else "")]
            fit = (f"scale={w}:{h}:force_original_aspect_ratio=decrease,"
                   f"pad={w}:{h}:(ow-iw)/2:(oh-ih)/2,setsar=1,")
            chunks = []
            for k, g in enumerate(groups):
                chunk = outdir / f".{base}.c{k}.mp4"
                sig = g[0][4]
                silent = audio and not sig[3]
                tries = []                              # (label, pre-input args, video filter)
                if gpu and abs(sig[1] / sig[2] - w / h) < 0.01:
                    # all on the GPU: decode, scale, encode (no letterboxing needed at the same aspect)
                    tries.append(("gpu", ["-hwaccel", "vaapi", "-hwaccel_device", dev, "-hwaccel_output_format", "vaapi"],
                                  f"scale_vaapi=w={w}:h={h}:format=nv12"))
                if gpu:                                 # CPU decode/scale, GPU encode
                    tries.append(("gpu-enc", ["-vaapi_device", dev], fit + "format=nv12,hwupload"))
                else:
                    tries.append(("cpu", [], fit + "format=yuv420p"))
                for n, (label, pre, vf) in enumerate(tries):
                    try:
                        ffmpeg_progress([
                            *pre, *concat_input(g),
                            *(["-f", "lavfi", "-i", "anullsrc=r=48000:cl=mono"] if silent else []),
                            "-map", "0:v", *(["-map", "1:a" if silent else "0:a"] if audio else []),
                            "-vf", vf, *venc, "-tag:v", "hvc1",
                            *(["-c:a", "aac", "-b:a", "64k", "-ar", "48000", "-ac", "1"] if audio else []),
                            *(["-shortest"] if silent else []),
                            "-f", "mp4", str(chunk)],
                            progress)
                        break
                    except RuntimeError as ex:
                        if n == len(tries) - 1:
                            raise
                        log(f"  {cam} run {k + 1}: {label} pipeline failed ({ex}); retrying with {tries[n + 1][0]}")
                chunks.append(chunk)
                done += group_len(g)
            name = f"{base}.mp4"
            tmp = outdir / f".{name}.part"
            lst = TMP / "chunks.txt"
            lst.write_text("ffconcat version 1.0\n" + "".join(f"file '{c}'\n" for c in chunks))
            ffmpeg("-f", "concat", "-safe", "0", "-i", str(lst), "-map", "0", "-c", "copy", "-tag:v", "hvc1",
                   "-movflags", "+faststart", "-f", "mp4", str(tmp))
            os.replace(tmp, outdir / name)
            for c in chunks:
                c.unlink(missing_ok=True)
            add_file(job, cam, outdir / name, sum(group_len(g) for g in groups))
    job["message"] = "; ".join(notes)


def group_len(g):
    """Seconds of footage a run of pieces yields: the first is cut at a, the last at b."""
    if len(g) == 1:
        return g[0][3] - g[0][2]
    return (g[0][1] - g[0][2]) + sum(p[1] for p in g[1:-1]) + g[-1][3]


def concat_input(g):
    """ffmpeg input args for a run of pieces: concat the whole files (durations pinned, as in join),
    then seek into the first and stop after the run's length."""
    lst = TMP / f"export-{os.urandom(3).hex()}.txt"
    lst.write_text("ffconcat version 1.0\n" + "".join(
        f"file '{p[0]}'\noutpoint {p[1]:.3f}\nduration {p[1]:.3f}\n" for p in g))
    return ["-ss", f"{g[0][2]:.3f}", "-t", f"{group_len(g):.3f}", "-f", "concat", "-safe", "0", "-i", str(lst)]


def add_file(job, cam, path, secs):
    job["files"].append({"camera": cam, "file": path.name, "size": path.stat().st_size, "duration": round(secs)})
    save_job(job)


def cmd_export(args):
    if args.job:
        job = load_job(args.job) if JOB_ID_RE.fullmatch(args.job) else None
        if not job:
            sys.exit(f"no such export job {args.job}")
    else:
        if not (args.cams and args.start and (args.end or args.duration)):
            sys.exit("export: need --cams, --start and --end or --duration (or --job ID)")
        s = parse_when(args.start)
        e = parse_when(args.end) if args.end else s + parse_dur(args.duration)
        cams = [c for c in re.split(r"[\s,]+", args.cams) if c]
        if args.gpu and not vaapi_ok():
            sys.exit(f"--gpu: VAAPI HEVC encoding doesn't work on {CONF['EXPORT_VAAPI_DEVICE'] or '(no device set)'}")
        enc = "vaapi" if args.gpu else "x265" if args.x265 else "copy"
        job = new_job(cams, s, e, enc, args.crf, args.height, state="running")
    for f in (EXPORTS / job["id"]).glob(".*"):        # leftovers of an interrupted attempt
        f.unlink()
    job.update(state="running", progress=0, files=[], message="", pid=os.getpid(), started=int(time.time()))
    save_job(job)

    def stop(_sig, _frm):
        raise KeyboardInterrupt
    import signal
    signal.signal(signal.SIGTERM, stop)
    try:
        run_export(job)
        job.update(state="done", progress=1)
    except KeyboardInterrupt:
        job.update(state="cancelled", message="cancelled")
    except Exception as ex:                            # noqa: BLE001 — report anything to the page
        job.update(state="failed", message=str(ex)[-500:])
        log(f"export {job['id']} failed: {ex}")
    finally:
        for f in (EXPORTS / job["id"]).glob(".*"):
            f.unlink(missing_ok=True)
        job["finished"] = int(time.time())
        job.pop("pid", None)
        save_job(job)
    for f in job["files"]:
        print(EXPORTS / job["id"] / f["file"])
    if job["message"]:
        log(job["message"])
    return 0 if job["state"] == "done" else 1


def list_jobs():
    jobs = []
    for d in EXPORTS.glob("*") if EXPORTS.is_dir() else []:
        if JOB_ID_RE.fullmatch(d.name):
            j = load_job(d.name)
            if j:
                jobs.append(j)
    return sorted(jobs, key=lambda j: j["id"], reverse=True)


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, TypeError):
        return False


def prune_exports():
    cutoff = time.time() - float(CONF["EXPORT_KEEP_DAYS"]) * 86400
    for j in list_jobs():
        if j["state"] not in ("queued", "running") and j.get("finished", j["created"]) < cutoff:
            shutil.rmtree(EXPORTS / j["id"], ignore_errors=True)


def cmd_serve(_args):
    """Small JSON API for the review page's Export panel. Listens on localhost only and has no
    auth of its own: put it behind the same nginx auth_request as the page (contrib/nginx-archive.conf)."""
    import signal
    import threading
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    tool = str(Path(__file__).resolve())
    lock = threading.Lock()
    cur = {"proc": None, "id": None}
    max_sec = float(CONF["EXPORT_MAX_HOURS"]) * 3600

    EXPORTS.mkdir(parents=True, exist_ok=True)
    for j in list_jobs():                              # interrupted by a restart: run them again
        if j["state"] == "running" and not pid_alive(j.get("pid")):
            j.update(state="queued", progress=0, message="restarted")
            save_job(j)

    def worker():
        while True:
            with lock:
                p = cur["proc"]
                if p and p.poll() is not None:
                    j = load_job(cur["id"])
                    if j and j["state"] == "running":  # died without recording why
                        j.update(state="failed", message=f"export process exited ({p.returncode})")
                        save_job(j)
                    cur.update(proc=None, id=None)
                if not cur["proc"]:
                    queued = [j for j in list_jobs() if j["state"] == "queued"]
                    if queued:
                        j = queued[-1]                 # oldest first
                        log(f"starting export {j['id']}")
                        cur["id"] = j["id"]
                        cur["proc"] = subprocess.Popen([sys.executable, tool, "export", "--job", j["id"]],
                                                       start_new_session=True)
            time.sleep(2)

    def cancel(jid):
        with lock:
            if cur["id"] == jid and cur["proc"]:
                os.killpg(cur["proc"].pid, signal.SIGTERM)   # takes ffmpeg down with it
                return True
            j = load_job(jid)
            if j and j["state"] == "queued":
                j.update(state="cancelled", message="cancelled", finished=int(time.time()))
                save_job(j)
                return True
        return False

    class H(BaseHTTPRequestHandler):
        def send(self, code, obj):
            body = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, fmt, *a):
            pass

        def parts(self):
            return [p for p in self.path.split("?")[0].split("/") if p]

        def do_GET(self):
            if self.parts() == ["exports"]:
                return self.send(200, {"jobs": list_jobs(), "max_hours": max_sec / 3600, "encoders": encoders(),
                                       "keep_days": float(CONF["EXPORT_KEEP_DAYS"])})
            self.send(404, {"error": "not found"})

        def do_POST(self):
            # JSON only: a cross-site form can't send it without a CORS preflight, which we never answer
            if self.headers.get("Content-Type", "").split(";")[0].strip() != "application/json":
                return self.send(415, {"error": "expected application/json"})
            n = int(self.headers.get("Content-Length") or 0)
            if n > 10000:
                return self.send(413, {"error": "too large"})
            try:
                body = json.loads(self.rfile.read(n) or b"{}")
            except json.JSONDecodeError:
                return self.send(400, {"error": "bad JSON"})
            p = self.parts()
            if len(p) == 3 and p[0] == "exports" and p[2] == "cancel" and JOB_ID_RE.fullmatch(p[1]):
                return self.send(200 if cancel(p[1]) else 409, {"ok": True})
            if p != ["exports"]:
                return self.send(404, {"error": "not found"})
            try:
                cams = body["cameras"]
                s, e = int(body["start"]), int(body["end"])
                enc = body.get("encode", "copy")
                crf = int(body.get("crf", 30))
                height = body.get("height") and int(body["height"])
                known = known_cameras()
                if (not isinstance(cams, list) or not 0 < len(cams) <= 32
                        or not all(isinstance(c, str) and CAM_RE.fullmatch(c) and c in known for c in cams)):
                    raise ValueError("unknown camera")
                if not 0 < e - s <= max_sec:
                    raise ValueError(f"range must be between 1 second and {max_sec / 3600:g} hours")
                if enc not in encoders() or crf not in CRFS or (height and height not in HEIGHTS):
                    raise ValueError("bad encoding options")
            except (KeyError, TypeError, ValueError) as ex:
                return self.send(400, {"error": str(ex)})
            job = new_job(sorted(set(cams), key=cams.index), s, e, enc, crf, height)
            self.send(201, job)

        def do_DELETE(self):
            p = self.parts()
            if len(p) != 2 or p[0] != "exports" or not JOB_ID_RE.fullmatch(p[1]) or not load_job(p[1]):
                return self.send(404, {"error": "not found"})
            if cancel(p[1]):
                for _ in range(20):                    # let it stop before removing its files
                    if load_job(p[1])["state"] not in ("queued", "running"):
                        break
                    time.sleep(0.5)
            shutil.rmtree(EXPORTS / p[1], ignore_errors=True)
            self.send(200, {"ok": True})

    host, _, port = CONF["EXPORT_LISTEN"].rpartition(":")
    threading.Thread(target=worker, daemon=True).start()
    srv = ThreadingHTTPServer((host or "127.0.0.1", int(port)), H)
    def stop(_sig, _frm):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, stop)
    log(f"export API on {CONF['EXPORT_LISTEN']}, jobs in {EXPORTS}, encoders: {', '.join(encoders())}")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    with lock:
        if cur["proc"]:
            os.killpg(cur["proc"].pid, signal.SIGTERM)
    return 0


# --- check -------------------------------------------------------------------

def cmd_check(_args):
    ok = True

    def report(good, what, detail=""):
        nonlocal ok
        ok &= good
        print(f"  [{'ok' if good else 'FAIL'}] {what}{f' — {detail}' if detail else ''}")

    print(f"config: {CONF_PATH}{'' if os.path.exists(CONF_PATH) else ' (not found, using defaults)'}")
    for tool in ("ffmpeg", "ffprobe", "rsync", "flock"):
        report(bool(shutil.which(tool)), f"{tool} installed")
    if CONF["MQTT_HOST"]:
        report(bool(shutil.which("mosquitto_pub")), "mosquitto_pub installed (MQTT_HOST is set)")
    if CONF["FRIGATE_API"].startswith("docker:"):
        report(bool(shutil.which("docker")), "docker installed (FRIGATE_API=docker:…)")
    report(SRC.is_dir(), f"Frigate recordings at {SRC}")
    report(MARKER.exists(), f"archive marker {MARKER}", "" if MARKER.exists() else
           "mount the archive, then: touch " + str(MARKER))
    cfg = api("config")
    report(bool(cfg), f"Frigate API via {CONF['FRIGATE_API']}")
    if cfg:
        cams = sorted(cfg.get("cameras", {}))
        print(f"       cameras: {', '.join(cams)}")
        for c in TL_CAMS:
            report(c in cams, f"timelapse camera '{c}' exists in Frigate")
        rec = cfg.get("record", {})
        days = rec.get("continuous", {}).get("days")
        if days is not None:
            print(f"       Frigate local continuous retention: {days} days "
                  f"(archive keeps {KEEP_DAYS:g}; raw staging covers the last "
                  f"{CONF['RAW_WINDOW_MIN']} min)")
    if CONF["EXPORT_VAAPI_DEVICE"]:
        print(f"       GPU (VAAPI) H.265 exports: {'available' if vaapi_ok() else 'not available'} "
              f"on {CONF['EXPORT_VAAPI_DEVICE']}")
    print(f"timezone for local days: {CONF['TZ'] or time.tzname[0] + ' (system)'}")
    return 0 if ok else 1


def main():
    global TMP
    if Path(sys.argv[0]).name == "frigate-clip":
        sys.argv.insert(1, "clip")
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"frigate-archive {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)
    for name in ("consolidate", "index", "filter", "harvest", "check"):
        sub.add_parser(name)
    t = sub.add_parser("timelapse")
    t.add_argument("date", nargs="?")
    t.add_argument("--cams")
    c = sub.add_parser("clip")
    c.add_argument("camera")
    c.add_argument("start")
    c.add_argument("duration")
    c.add_argument("out", nargs="?")
    x = sub.add_parser("export")
    x.add_argument("--job", help="run a job queued by serve")
    x.add_argument("--cams", help="comma separated")
    x.add_argument("--start", help="'YYYY-MM-DD HH:MM[:SS]' local time")
    x.add_argument("--end")
    x.add_argument("--duration", help="instead of --end: 45m, 1h30m, ...")
    x.add_argument("--x265", action="store_true", help="re-encode to H.265 (slow; smaller, one file per camera)")
    x.add_argument("--gpu", action="store_true", help="re-encode to H.265 on the GPU (VAAPI): fast, one file per camera")
    x.add_argument("--crf", type=int, default=30, choices=CRFS, metavar="18-40", help="quality (x265 CRF / VAAPI ICQ)")
    x.add_argument("--height", type=int, choices=HEIGHTS, help="scale down to this height (with --x265/--gpu)")
    sub.add_parser("serve")
    a = p.parse_args()
    if a.cmd not in ("filter", "check") and not MARKER.exists():
        sys.exit(f"{ARCHIVE} not mounted (marker {MARKER} missing)")
    # private scratch dir per process, so a manual run can't collide with the timer's
    Path(CONF["TMP_DIR"]).mkdir(parents=True, exist_ok=True)
    TMP = Path(tempfile.mkdtemp(prefix=f"{a.cmd}-", dir=CONF["TMP_DIR"]))
    try:
        rc = {"consolidate": cmd_consolidate, "index": cmd_index, "filter": cmd_filter, "harvest": cmd_harvest,
              "timelapse": cmd_timelapse, "clip": cmd_clip, "check": cmd_check,
              "export": cmd_export, "serve": cmd_serve}[a.cmd](a)
    finally:
        shutil.rmtree(TMP, ignore_errors=True)
    sys.exit(rc or 0)


if __name__ == "__main__":
    main()

# frigate-archive for hosts without systemd: copy to /etc/cron.d/frigate-archive
# (install with ./install.sh --no-systemd first).
#
# Times are in the cron daemon's timezone (usually the system's). If TZ in the config is
# different, shift the timelapse hour to match, or (cronie) put CRON_TZ=<your zone> above it.
# The timelapse should run a little after midnight in TZ: it builds "yesterday".
#
# frigate-archive locks itself (LOCK_FILE), so a slow run just makes the next start a no-op.
# The export API (frigate-archive-tool serve) is a long-running process: run it under your
# service supervisor instead (OpenRC, runit, s6, supervisord, ...).

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

*/5 * * * *  root  nice -n 10 frigate-archive >>/var/log/frigate-archive.log 2>&1
30 1 * * *   root  nice -n 15 frigate-archive-tool timelapse >>/var/log/frigate-archive.log 2>&1
